# ---------- La página (app.py) ----------
SECRET_KEY=pega-aqui-tu-clave

# Base de datos que usa la página. En tu computador: MAMP. En Render: Aiven.
DB_HOST=127.0.0.1
DB_PORT=8889
DB_USER=root
DB_PASSWORD=root
DB_NAME=ioturtle
# Opcional: ruta al certificado ca.pem de Aiven para verificar la conexión
# DB_SSL_CA=ca.pem

# Opcional: iniciar sesión con Google (si no están, el botón no aparece)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Asistente con IA (console.groq.com → API Keys). Sin esta clave la pestaña Asistente queda desactivada
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Opcional: 0 para dejar de simular las zonas Soleada, Intermedia y Sombra
# SIMULAR_ZONAS=1

# ---------- Solo para migrar_a_aiven.py ----------
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=8889
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=root
LOCAL_DB_NAME=ioturtle

AIVEN_HOST=mysql-xxxxxxxx.aivencloud.com
AIVEN_PORT=12345
AIVEN_USER=avnadmin
AIVEN_PASSWORD=pega-aqui-la-clave-de-aiven
AIVEN_DB=defaultdb
# AIVEN_SSL_CA=ca.pem
